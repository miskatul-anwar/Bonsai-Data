@prefix bont: <http://ontology.bonsai.uno/core#> .
@prefix bont_agent: <http://bonsai.uno/foaf/bonsai.rdf#> .
@prefix bont_base: <http://ontology.bonsai.uno/> .
@prefix bont_core: <http://ontology.bonsai.uno/core/> .
@prefix cc: <http://creativecommons.org/ns#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix exio: <http://exiobase/source/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix om2: <http://www.ontology-of-units-of-measure.org/resource/om-2/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema1: <http://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

exio:Code a owl:DatatypeProperty ;
    rdfs:domain exio:Flowobject ;
    rdfs:range xsd:string .

exio:Name a owl:DatatypeProperty ;
    rdfs:domain exio:Flowobject ;
    rdfs:range xsd:string .

exio:activityId a owl:DatatypeProperty ;
    rdfs:domain exio:Activity ;
    rdfs:range xsd:string .

exio:hasActivityType a owl:DatatypeProperty ;
    rdfs:domain exio:Activity ;
    rdfs:range xsd:string .

exio:hasLocation a owl:DatatypeProperty ;
    rdfs:domain exio:Activity ;
    rdfs:range xsd:string .

exio:hasNumericalValue a owl:DatatypeProperty ;
    rdfs:domain exio:Inputflow,
        exio:Outputflow ;
    rdfs:range xsd:string .

exio:hasObjectType a owl:DatatypeProperty ;
    rdfs:domain exio:Inputflow,
        exio:Outputflow ;
    rdfs:range xsd:string .

exio:hasTemporalExtent a owl:DatatypeProperty ;
    rdfs:domain exio:Activity ;
    rdfs:range xsd:string .

exio:hasUnit a owl:DatatypeProperty ;
    rdfs:domain exio:Inputflow,
        exio:Outputflow ;
    rdfs:range xsd:string .

exio:isInputOf a owl:DatatypeProperty ;
    rdfs:domain exio:Inputflow ;
    rdfs:range xsd:string .

exio:isOutputOf a owl:DatatypeProperty ;
    rdfs:domain exio:Outputflow ;
    rdfs:range xsd:string .

bont_base:core a owl:Ontology ;
    cc:license <http://creativecommons.org/licenses/by/3.0/> ;
    dcterms:contributor "Agneta Ghose",
        "Bo Weidemma",
        "Massimo Pizzol",
        "Matteo Lissandrini" ;
    dcterms:creator bont_agent:bonsai ;
    dcterms:description "The BONSAI ontologies provides elements of description for product footprint concepts defined in the bonsai.uno data base"@en ;
    dcterms:modified "2019-03-25"^^xsd:date,
        "2020-04-23"^^xsd:date,
        "2022-03-15"^^xsd:date ;
    dcterms:publisher "bonsai.uno" ;
    dcterms:title "The BONSAI ontology"@en ;
    vann:preferredNamespacePrefix "bont" ;
    vann:preferredNamespaceUri "http://ontology.bonsai.uno/core#" ;
    rdfs:comment """Bonsai ontology version 0.2 :
                based on changes discussed on Jan2020!
               """@en,
        """First ever version 0.1 :
                  Will change!
               """@en ;
    rdfs:isDefinedBy bont_core:ontology_v0.1.rdf,
        bont_core:ontology_v0.2.rdf ;
    owl:versionInfo "Version 0.1 - 2019-03-25"@en,
        "Version 0.2 - 2020-04-23"@en,
        "Version 0.2 - 2022-03-15"@en ;
    foaf:homepage bont_core:documentation.html .

bont:activityType a owl:ObjectProperty ;
    rdfs:label "activity type"@en ;
    rdfs:comment "Type of the Activity that is performed."@en ;
    rdfs:domain bont:Activity ;
    rdfs:range bont:ActivityType ;
    rdfs:subPropertyOf dcterms:type .

bont:determiningFlow a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "determining flow"@en ;
    rdfs:comment "Specific flow object produced or consumed by an activity for which a change in demand or supply will affect the activity level (such as its production volume or extent)."@en ;
    rdfs:domain bont:Activity ;
    rdfs:range bont:Flow .

bont:hasActivityType a owl:ObjectProperty ;
    rdfs:label "activity type"@en ;
    rdfs:comment "Specifies the ActivityType that is an instance of the Activity."@en,
        "Specifies the label of an Activity."@en ;
    rdfs:domain bont:Activity ;
    rdfs:range bont:ActivityType ;
    rdfs:subPropertyOf dcterms:type .

bont:hasBalanceableProperty a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has balanceable property"@en ;
    rdfs:comment "Specifies that the quantity used to measure flows that follows a conservation law."@en,
        "Specifies the  Measure of a Flow when this Measure is a BalanceableProperty, i.e. when it follows a conservation law."@en ;
    rdfs:domain bont:Flow ;
    rdfs:range bont:BalanceableProperty .

bont:hasDeterminingFlow a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "determining flow"@en ;
    rdfs:comment "Specifies a specific flow object produced or consumed by an activity for which a change in demand or supply will affect the activity level (such as its production volume or extent)."@en ;
    rdfs:domain bont:Activity ;
    rdfs:range bont:Flow .

bont:hasLocation a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "located at"@en ;
    rdfs:comment "Specifies the location of an Activity or Agent"@en ;
    rdfs:domain [ owl:unionOf [ ] ],
        [ owl:unionOf [ ] ],
        [ owl:unionOf [ ] ],
        bont:Activity ;
    rdfs:range schema1:location .

bont:hasObjectType a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "object type"@en ;
    rdfs:comment "Specifies the Flow object consumed or produced."@en ;
    rdfs:domain bont:Flow ;
    rdfs:range bont:FlowObject ;
    rdfs:subPropertyOf dcterms:type .

bont:hasPropertyType a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "property type"@en ;
    rdfs:comment "Specifies the dimension (Quantity) of a Measure that is classified as a BalanceableProperty."@en,
        "Specifies types of quantities that are classified as BalanceableProperty"@en ;
    rdfs:domain bont:BalanceableProperty ;
    rdfs:range bont:BalanceablePropertyType .

bont:hasReferenceFlowObject a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "references flow object"@en ;
    rdfs:comment "Specifies a FlowObject that functions as the ReferenceUnit for a BalanceableProperty measure."@en,
        "Specifies the flow object referenced by the reference unit."@en ;
    rdfs:domain bont:ReferenceUnit ;
    rdfs:range bont:FlowObject .

bont:hasTemporalExtent a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "temporal extent"@en ;
    rdfs:comment "Specifies the temporal extent for an activity."@en ;
    rdfs:domain bont:Activity ;
    rdfs:range om2:,
        time:ProperInterval .

bont:inputOf a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "input of"@en ;
    rdfs:comment "A flow that is input of an activity."@en ;
    rdfs:domain bont:Flow ;
    rdfs:range bont:Activity .

bont:isInputOf a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "input of"@en ;
    rdfs:comment "Specifies the Activity that a Flow is an input to."@en ;
    rdfs:domain bont:Flow ;
    rdfs:range bont:Activity .

bont:isOutputOf a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "output of"@en ;
    rdfs:comment "Specifies the Activity that a Flow is an output of."@en ;
    rdfs:domain bont:Flow ;
    rdfs:range bont:Activity .

bont:isProportionalTo a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "proportional to"@en ;
    rdfs:comment "Specifies the reference unit that the amount of a BalanceableProperty of a Flow is proportional to."@en,
        "Specifies the reference unit to which the quantity of the Flow is proportional."@en ;
    rdfs:domain bont:BalanceableProperty ;
    rdfs:range bont:ReferenceUnit .

bont:location a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "located at"@en ;
    rdfs:comment "The location in which an activity took place or agent is located."@en ;
    rdfs:domain [ owl:unionOf [ ] ] ;
    rdfs:range schema1:location .

bont:objectType a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "object type"@en ;
    rdfs:comment "Type of the Flow Object that is consumed or produced."@en ;
    rdfs:domain bont:Flow ;
    rdfs:range bont:FlowObject ;
    rdfs:subPropertyOf dcterms:type .

bont:outputOf a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "output of"@en ;
    rdfs:comment "A flow that is output of an activity."@en ;
    rdfs:domain bont:Flow ;
    rdfs:range bont:Activity .

bont:performs a owl:ObjectProperty ;
    rdfs:label "performs"@en ;
    rdfs:comment "Specifies the Agent who performs an activity."@en,
        "The activity performed by the agent."@en ;
    rdfs:domain bont:Agent ;
    rdfs:range bont:Activity .

bont:proportionalTo a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "proportional to"@en ;
    rdfs:comment "The reference unit to which the quantity of the Flow is proportional."@en ;
    rdfs:domain bont:Flow ;
    rdfs:range bont:ReferenceUnit .

bont:referenceFlowObject a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "references flow object"@en ;
    rdfs:comment "The flow object referenced by the reference unit."@en ;
    rdfs:domain bont:ReferenceUnit ;
    rdfs:range bont:FlowObject .

bont:temporalExtent a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "temporal extent"@en ;
    rdfs:comment "Temporal extent for an activity."@en ;
    rdfs:domain bont:Activity ;
    rdfs:range time:ProperInterval .

om2:hasNumericalValue a owl:DatatypeProperty ;
    rdfs:domain bont:Flow ;
    rdfs:range xsd:string .

om2:hasUnit a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "Unit of flow object"@en ;
    rdfs:comment "Unit to measure flowobjects."@en ;
    rdfs:domain bont:Flow ;
    rdfs:range om2: .

rdfs:label a owl:DatatypeProperty ;
    rdfs:domain bont:Activity,
        bont:ActivityType,
        bont:Flow,
        bont:FlowObject ;
    rdfs:range xsd:string .

xsd:float a rdfs:Datatype .

xsd:integer a rdfs:Datatype .

bont:Agent a owl:Class ;
    rdfs:label "Agent"@en ;
    rdfs:comment "An entity (person or thing) that performs an activity, usually it has a specific location."@en,
        "An entity that performs an activity, usually it has a specific location."@en ;
    rdfs:subClassOf skos:ConceptScheme .

bont:BalanceablePropertyType a owl:Class ;
    rdfs:label "Balanceable Property Type"@en ;
    rdfs:comment "Contains the instances of BalanceableProperty such as dry mass, wet mass, elemental mass, person-time, monetary value."@en,
        "Contains the labels of BalanceableProperty such as dry mass, wet mass, elemental mass, person-time, monetary value."@en ;
    rdfs:subClassOf om2:Quantity,
        skos:ConceptScheme .

exio:Flowobject a owl:Class .

bont:ActivityType a owl:Class ;
    rdfs:label "Activity Type"@en ;
    rdfs:comment "The type of an activity, e.g, stock accumulation, steel production, etc."@en,
        "The type of an activity, e.g, stock accumulation, steel production, etc. This class includes the labels of activities. Includes both human activities and environmental mechanisms."@en ;
    rdfs:subClassOf skos:ConceptScheme .

bont:BalanceableProperty a owl:Class ;
    rdfs:label "Balanceable Property"@en ;
    rdfs:comment "A balanceable property is a Quantity for which the sum for all input flows must equal the sum for all output flows e.g. dry mass, water mass, energy, elemental mass, person-time, monetary value (when measured in the same valuation)."@en,
        "A quantity for which the sum for all input flows must equal the sum for all output flows. A quantity that follows a conservation law. Balanceable properties are particularly relevant for validating the completeness and consistency of an Activity description or a database of such activities. "@en ;
    rdfs:subClassOf om2:Measure,
        om2:Quantity,
        skos:ConceptScheme .

exio:Activity a owl:Class .

exio:Inputflow a owl:Class .

exio:Outputflow a owl:Class .

bont:ReferenceUnit a owl:Class ;
    rdfs:label "Reference Unit"@en ;
    rdfs:comment " The measure to which the numeric value representing the measure of a Flow is expressed 'in proportion to'. In LCA, the term ‘Functional Unit’ is defined as a common ReferenceUnit for all activities in an LCA study."@en,
        "The quantity to which the quantity of a Flow should be seen proportional to. This could be, for instance, 1 Year, or per tonne of steel."@en ;
    rdfs:subClassOf om2:Measure,
        skos:ConceptScheme .

bont:FlowObject a owl:Class ;
    rdfs:label "Flow Object"@en,
        "Type of the people"@en ;
    rdfs:comment "An entity that is produced or consumed by an activity or stored by a (stock accumulation) activity."@en,
        "This class includes the labels of entities that are produced or consumed by an activity or added to or removed from a stock accumulation."@en ;
    rdfs:range bont:FlowObject ;
    rdfs:subClassOf skos:ConceptScheme .

bont:Activity a owl:Class ;
    rdfs:label "Activity"@en,
        "Type of the people"@en ;
    rdfs:comment "Activity is the act of making or doing something which is defined both spatially and temporally. Includes both human activities and environmental mechanisms."@en,
        "Activity is the act of making or doing something which is defined both spatially and temporally. This is one of the identifying dimensions of a datapoint. This class defines multiple properties on the type and direction of flows. ‘Process’ is a commonly used synonym in other LCA databases."@en ;
    rdfs:range bont:Activity ;
    rdfs:subClassOf skos:ConceptScheme .

bont:Flow a owl:Class ;
    rdfs:label "Flow"@en,
        "Type of the people"@en ;
    rdfs:comment " An input or output of an entity to or from an instance of an Activity or a directional exchange of an entity between two instances of Activity. This class contains the quantity of the entity (Flow Object) that is consumed as input or produced as output of an Activity."@en,
        "An observation representing a quantity of Flow Object that is consumed as input or produced as output of an Activity."@en ;
    rdfs:range bont:Flow ;
    rdfs:subClassOf om2:Measure,
        skos:ConceptScheme .

